#!/bin/sh

### BEGIN INIT INFO
# Provides: c300x-native-agent
# Default-Start: 5
# Default-Stop: 0 1 6
# Short-Description: BTicino C300X native agent
### END INIT INFO

PATH=/sbin:/usr/sbin:/bin:/usr/bin
DEFAULT_AGENT_DIR="/home/bticino/cfg/extra/c300x-native-agent"
AGENT_ENV="${C300X_AGENT_ENV:-$DEFAULT_AGENT_DIR/c300x-agent.env}"
[ -r "$AGENT_ENV" ] && . "$AGENT_ENV"
AGENT_DIR="${C300X_AGENT_DIR:-${AGENT_DIR:-$DEFAULT_AGENT_DIR}}"
C300X_AGENT_DIR="$AGENT_DIR"
C300X_BACKUP_ROOT="${C300X_BACKUP_ROOT:-/home/bticino/cfg/extra/c300x-device-file-backups}"
export C300X_AGENT_DIR C300X_BACKUP_ROOT
AGENT_BIN="$AGENT_DIR/c300x-agent-native"
AGENT_CONFIG="$AGENT_DIR/config.json"
AGENT_PID="$AGENT_DIR/c300x-agent-native.pid"

[ -f /etc/init.d/functions ] && . /etc/init.d/functions

pause() {
    usleep 100000 >/dev/null 2>&1 || sleep 1
}

pidfile_pid() {
    pid="$(cat "$AGENT_PID" 2>/dev/null)"
    case "$pid" in
        ""|*[!0-9]*) return 1 ;;
    esac
    printf '%s\n' "$pid"
}

is_agent() {
    exe="$(readlink "/proc/$1/exe" 2>/dev/null)" || return 1
    exe="${exe% (deleted)}"
    [ -n "$exe" ] || return 1
    [ "$exe" = "$AGENT_BIN" ] || [ "$exe" = "$(readlink -f "$AGENT_BIN" 2>/dev/null)" ]
}

wait_gone() {
    tries="$2"
    while kill -0 "$1" >/dev/null 2>&1 && is_agent "$1"; do
        [ "$tries" -gt 0 ] || return 1
        tries=$((tries - 1))
        pause
    done
    return 0
}

case "$1" in
    start)
        if [ ! -x "$AGENT_BIN" ] || [ ! -f "$AGENT_CONFIG" ]; then
            exit 1
        fi
        start-stop-daemon --start --quiet --oknodo --background \
            --make-pidfile --pidfile "$AGENT_PID" \
            --exec "$AGENT_BIN" -- --config "$AGENT_CONFIG"
        exit $?
        ;;
    stop)
        pid="$(pidfile_pid)" || pid=""
        start-stop-daemon --stop --quiet --oknodo \
            --pidfile "$AGENT_PID" --exec "$AGENT_BIN" || exit $?
        if [ -n "$pid" ] && ! wait_gone "$pid" 50; then
            is_agent "$pid" && kill -KILL "$pid" >/dev/null 2>&1
            wait_gone "$pid" 20 || exit 1
        fi
        rm -f "$AGENT_PID" || exit $?
        ;;
    restart)
        "$0" stop || exit $?
        "$0" start || exit $?
        pause
        tries=20
        while [ "$tries" -gt 0 ]; do
            "$0" status || exit 1
            tries=$((tries - 1))
            pause
        done
        exit 0
        ;;
    status)
        pid="$(pidfile_pid)" && kill -0 "$pid" >/dev/null 2>&1 && is_agent "$pid" && exit 0
        exit 3
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}" >&2
        exit 2
        ;;
esac

exit 0
